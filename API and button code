<script defer>
function summarizeBlog() {
    const blogContent = `<?= addslashes($blog_dt->blog_content); ?>`;  // PHP code to inject the content into JavaScript

    // Fetch request to get the summary
    fetch("http://127.0.0.1:8000/api/summarize/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ "text": blogContent })
    })
    .then(response => response.json())
    .then(data => {
        if (data.summary) {
            // Insert the summary into the modal body
            document.getElementById("summaryContent").textContent = data.summary;
            // Use Bootstrap's modal functionality to show the modal
            const myModal = new bootstrap.Modal(document.getElementById('summaryModal'));
            myModal.show();
        } else {
            alert("Error: " + data.error || "Summary not available.");
        }
    })
    .catch(error => {
        alert("An error occurred: " + error.message);
    });
}

</script>
